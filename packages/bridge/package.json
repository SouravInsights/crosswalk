{
  "name": "@groundstate/bridge",
  "version": "0.0.1",
  "description": "Local MCP server that connects a running page's Groundstate tools to any MCP client (Claude Code, Codex, Cursor) via CDP.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "groundstate-bridge": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --sourcemap --clean",
    "dev": "tsup src/index.ts src/cli.ts --format esm --dts --sourcemap --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "agents",
    "cdp",
    "groundstate"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chrome-remote-interface": "^0.34.0",
    "groundstate": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.34.0"
  }
}
