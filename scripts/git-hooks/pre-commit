#!/bin/sh
# Pre-commit: lint and format exactly what is staged, never the whole tree.
#
# This hook exists because "remember to run pnpm lint" failed in practice:
# a whole branch once reached CI unlinted. Git runs this file, so neither a
# tired human nor an agent can skip it. Auto-fixable problems (formatting,
# import order) are fixed and re-staged; anything else blocks the commit
# with the diagnostics printed.

staged=$(git diff --cached --name-only --diff-filter=ACMR -z |
  tr '\0' '\n' |
  grep -E '\.(ts|tsx|js|jsx|mjs|cjs|json|jsonc|css|md|mdx)$' || true)

if [ -z "$staged" ]; then
  exit 0
fi

# Hooks inherit the committer's environment; GUI git clients and stripped
# shells may not have pnpm on PATH. Fall back to the repo's own biome binary.
if command -v pnpm >/dev/null 2>&1; then
  biome="pnpm exec biome"
elif [ -x ./node_modules/.bin/biome ]; then
  biome="./node_modules/.bin/biome"
else
  echo "pre-commit: neither pnpm nor node_modules/.bin/biome found; run pnpm install first."
  exit 1
fi

# --no-errors-on-unmatched: a commit that stages only biome-ignored files
# (docs markdown, etc.) is a pass, not a failure.
echo "$staged" | tr '\n' '\0' | xargs -0 $biome check --write --no-errors-on-unmatched
status=$?

# Re-stage whatever biome fixed, so the commit contains the fixed version.
echo "$staged" | tr '\n' '\0' | xargs -0 git add

if [ $status -ne 0 ]; then
  echo ""
  echo "biome found issues it could not auto-fix. Fix them, stage, and commit again."
  exit 1
fi
